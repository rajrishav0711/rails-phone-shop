<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Phone Shop" %> | Phone Shop</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to "Phone Shop", admin_path, class: "brand" %>
        <nav>
          <%= link_to "Phones", admin_phones_path, class: "nav-link" %>
          <%= link_to "Add Phone", new_admin_phone_path, class: "button button-primary" %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <div class="flash flash-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash flash-error"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
