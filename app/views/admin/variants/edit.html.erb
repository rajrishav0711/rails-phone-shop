<% content_for :title, "Edit Variant" %>
<section class="page-header">
  <div>
    <p class="eyebrow">Inventory / <%= @phone.name %></p>
    <h1>Edit Variant</h1>
    <p class="muted"><%= @variant.name %></p>
  </div>
</section>

<div class="card">
  <%= form_with model: [:admin, @variant], local: true do |form| %>
  <% if @variant.errors.any? %>
    <div class="error-summary">
      <h3><%= pluralize(@variant.errors.count, "error") %> prevented this variant from being saved:</h3>
      <ul>
        <% @variant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :storage %>
      <%= form.text_field :storage, placeholder: "e.g. 64 GB", required: true, autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :color %>
      <%= form.text_field :color, placeholder: "e.g. Black", required: true %>
    </div>

    <div class="field">
      <%= form.label :count_on_hand, "Count on hand" %>
      <%= form.number_field :count_on_hand, min: 0, required: true %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit @variant.persisted? ? "Save changes" : "Create variant", class: "button button-primary" %>
    <%= link_to "Cancel", admin_phone_path(@variant.phone), class: "button button-secondary" %>
  </div>
<% end %>

</div>
