<% content_for :title, "All Phones" %>

<div class="row">
  <div class="col-lg-12">
    <div class="ibox float-e-margins">
      <div class="ibox-title">
        <h5>All Phones Data</h5>
      </div>
      <div class="ibox-content">
        <div class="table-responsive">
          <table class="table table-striped table-bordered table-hover dataTables-example">
            <thead>
            <tr>
              <th>Name</th>
              <th>Manufacture Year</th>
              <th width="101px">Actions</th>
            </tr>
            </thead>
            <tbody>
            <% @phones.each do |phone| %>
              <tr class="">
                <td><%=link_to phone.name, admin_phone_path(phone) %></td>
                <td><%= phone.manufacture_year %></td>
                <td>
                  <%= link_to admin_phone_path(phone.id), method: :delete, data: {confirm: 'Are you sure?'} do %>
                    <i class="tab" aria-hidden="false">remove</i>
                  <% end %>
                  <%= link_to edit_admin_phone_path(phone.id) do %>
                    <i class="tab" aria-hidden="false">edit</i>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>