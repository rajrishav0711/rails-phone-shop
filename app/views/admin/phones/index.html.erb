<% content_for :title, "Phones" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Inventory</p>
    <h1>Phones</h1>
    <p class="muted"><%= pluralize(@phones.size, "phone") %> registered.</p>
  </div>
  <%= link_to "Add Phone", new_admin_phone_path, class: "button button-primary" %>
</section>

<div class="card">
  <% if @phones.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Phone</th>
            <th>Manufacture year</th>
            <th>Variants</th>
            <th class="actions-column">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @phones.each do |phone| %>
            <tr>
              <td><%= link_to phone.name, admin_phone_path(phone), class: "table-link" %></td>
              <td><%= phone.manufacture_year || "-" %></td>
              <td><%= phone.variants.size %></td>
              <td class="actions">
                <%= link_to "Edit", edit_admin_phone_path(phone), class: "button button-secondary button-sm" %>
                <%= button_to "Delete", admin_phone_path(phone), method: :delete,
                      class: "button button-danger button-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No phones yet</h2>
      <p>Start by registering the first phone model.</p>
      <%= link_to "Add Phone", new_admin_phone_path, class: "button button-primary" %>
    </div>
  <% end %>
</div>
