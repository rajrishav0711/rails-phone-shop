<% content_for :title, @phone.name %>

<section class="page-header">
  <div>
    <p class="eyebrow">Phone</p>
    <h1><%= @phone.name %></h1>
    <p class="muted">Manufactured in <%= @phone.manufacture_year || "unknown year" %>.</p>
  </div>
  <div class="button-group">
    <%= link_to "Edit", edit_admin_phone_path(@phone), class: "button button-secondary" %>
    <%= link_to "Add Variant", new_admin_phone_variant_path(@phone), class: "button button-primary" %>
  </div>
</section>

<div class="card">
  <div class="details-grid">
    <div><span>Manufacturer</span><strong><%= @phone.manufacturer %></strong></div>
    <div><span>Model</span><strong><%= @phone.model %></strong></div>
    <div><span>Manufacture year</span><strong><%= @phone.manufacture_year || "-" %></strong></div>
    <div><span>Variants</span><strong><%= pluralize(@phone.variants.size, "variant") %></strong></div>
  </div>
</div>

<div class="section-header">
  <h2>Variants</h2>
  <%= link_to "Manage variants", admin_phone_variants_path(@phone) %>
</div>

<div class="card">
  <% if @phone.variants.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Storage</th>
            <th>Color</th>
            <th>Stock</th>
            <th>Price</th>
            <th class="actions-column">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @phone.variants.includes(:price).each do |variant| %>
            <tr>
              <td><%= variant.storage %></td>
              <td><%= variant.color %></td>
              <td><%= variant.count_on_hand %></td>
              <td><%= variant.price ? number_to_currency(variant.price.amount) : "-" %></td>
              <td class="actions">
                <%= link_to "Edit", edit_admin_variant_path(variant), class: "button button-secondary button-sm" %>
                <%= button_to "Delete", admin_variant_path(variant), method: :delete,
                      class: "button button-danger button-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No variants have been registered for this phone.</p>
      <%= link_to "Add Variant", new_admin_phone_variant_path(@phone), class: "button button-primary" %>
    </div>
  <% end %>
</div>
