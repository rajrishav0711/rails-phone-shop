<% content_for :title, "Add Phone" %>
<section class="page-header">
  <div>
    <p class="eyebrow">Inventory</p>
    <h1>Add Phone</h1>
    <p class="muted">Register a new phone model.</p>
  </div>
</section>

<div class="card">
  <%= form_with model: [:admin, @phone], local: true do |form| %>
  <% if @phone.errors.any? %>
    <div class="error-summary">
      <h3><%= pluralize(@phone.errors.count, "error") %> prevented this phone from being saved:</h3>
      <ul>
        <% @phone.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :manufacturer %>
      <%= form.text_field :manufacturer, placeholder: "e.g. Apple", required: true, autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :model %>
      <%= form.text_field :model, placeholder: "e.g. iPhone 15", required: true %>
    </div>

    <div class="field">
      <%= form.label :manufacture_year %>
      <%= form.number_field :manufacture_year, min: 1951, max: 2050, placeholder: "e.g. 2025" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit @phone.persisted? ? "Save changes" : "Create phone", class: "button button-primary" %>
    <%= link_to "Cancel", @phone.persisted? ? admin_phone_path(@phone) : admin_phones_path, class: "button button-secondary" %>
  </div>
<% end %>

</div>
